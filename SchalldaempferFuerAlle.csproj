<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SchalldaempferFuerAlle</AssemblyName>
    <RootNamespace>SchalldaempferFuerAlle</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS1701;CS1702;NU1701</NoWarn>
    <GameDir Condition="'$(GameDir)' == ''">/mnt/nvmegames/Games/SPT-416</GameDir>
    <ServerDir Condition="'$(ServerDir)' == ''">$(GameDir)/SPT_Runtime</ServerDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <!-- HttpContext kommt aus ASP.NET Core, das der Server mitbringt. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SPTarkov.Server.Core"><HintPath>$(ServerDir)/SPTarkov.Server.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.DI"><HintPath>$(ServerDir)/SPTarkov.DI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.Common"><HintPath>$(ServerDir)/SPTarkov.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SemanticVersioning"><HintPath>$(ServerDir)/SemanticVersioning.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Nur mit -p:Installieren=true kopieren. -->
  <Target Name="InsSpiel" AfterTargets="Build" Condition="'$(Installieren)' == 'true'">
    <MakeDir Directories="$(ServerDir)/user/mods/SchalldaempferFuerAlle" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ServerDir)/user/mods/SchalldaempferFuerAlle" />
    <Message Importance="high" Text="-> user/mods/SchalldaempferFuerAlle/ (Server neu starten)" />
  </Target>

</Project>
